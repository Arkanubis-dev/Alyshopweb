# ==============================================================================
# ALYSHOP - VARIABLES DE ENTORNO
# Copia este archivo como .env.local para desarrollo local
# ==============================================================================

# Supabase URL y Anon Key (públicos)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Supabase Service Role Key (PRIVADO - solo para el servidor, NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Número de WhatsApp de la tienda (código de país 57 + celular de 10 dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=573213052913

# URL pública de la tienda
NEXT_PUBLIC_SITE_URL=http://localhost:3000
